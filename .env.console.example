SPARK_DATA_DIR=/data
SPARK_COOKIE_KEY_FILE=/run/secrets/cookie.key
SPARK_SESSION_KEY_FILE=/run/secrets/session.key
SPARK_WEB_BIND=0.0.0.0
SPARK_WEB_PORT=8899
SPARK_WEB_PUBLISH_IP=127.0.0.1
SPARK_SECURE_COOKIES=true
SPARK_TIMEZONE=Asia/Shanghai
# spark-worker 与无端口的 spark-auth 共用此数据库轮询间隔（秒）。
SPARK_WORKER_POLL_SECONDS=10
SPARK_CLOCK_OFFSET_LIMIT_SECONDS=5
SPARK_BUILD_PIP_INDEX_URL=https://pypi.org/simple
# Cookie 失效提醒邮件（spark-worker 使用）。收件人是抖音号所属用户自己的 users.email。
# 不填 SPARK_SMTP_USER / SPARK_SMTP_PASSWORD 时自动跳过发送，只在日志留一条 warning。
# SPARK_SMTP_SECURITY 可选 ssl(465) / starttls(587) / plain；SPARK_SMTP_FROM 留空时用 SPARK_SMTP_USER。
SPARK_SMTP_HOST=smtp.qq.com
SPARK_SMTP_PORT=465
SPARK_SMTP_SECURITY=ssl
SPARK_SMTP_USER=
SPARK_SMTP_PASSWORD=
SPARK_SMTP_FROM=
